# ─────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4200

# ─────────────────────────────────────────────────────────────
# Base de datos (contenedor docker-compose, puerto 5435)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://triaje:triaje@localhost:5435/triaje

# ─────────────────────────────────────────────────────────────
# TypeSafe / Jev  →  clasificación tipada de eventos
# Clave: https://typesafe.ai  (panel de la cuenta)
# El SDK -ai/sdk lee estas tres variables automáticamente.
# ─────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# ─────────────────────────────────────────────────────────────
# OpenRouter  →  redacción de explicaciones en lenguaje natural
# Clave: https://openrouter.ai/keys  (empieza por sk-or-v1-)
# Catálogo de modelos: https://openrouter.ai/models
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Cabeceras opcionales de atribución que OpenRouter muestra en su ranking.
OPENROUTER_SITE_URL=http://localhost:4200
OPENROUTER_SITE_NAME="Encomiendas Demo"

# ─────────────────────────────────────────────────────────────
# Simulador
# ─────────────────────────────────────────────────────────────
# Con 'false' NO entran llamadas solas: solo las que generes desde la interfaz.
# Así se puede seguir una llamada completa de principio a fin.
SIMULATOR_ENABLED=false
SIMULATOR_CREATE_SECONDS=45
# Cada cuánto avanzan las ambulancias en el mapa. Corre siempre.
SIMULATOR_ADVANCE_SECONDS=1
SIMULATOR_SEED=
